# Copy to .env and fill in. Local dev can leave DEBUG=True and skip the rest.

# --- Core ---
# Generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Production only (DEBUG=False) ---
# Comma-separated. Required when DEBUG=False.
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# Frontend origins allowed to call the API (scheme + host).
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
# Origins trusted for CSRF (admin over HTTPS).
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# Postgres for production instead of sqlite.
# DATABASE_URL=postgres://user:password@host:5432/dbname
